// deploy/zenoh/zenohd-rt.json5
//
// INF-ZN-8 -- RT-plane Zenoh router config for the xbrain-zenohd-rt.service
// unit. This is the 20 Hz control-plane router that only sees loopback
// traffic between P1 / chassis_relay / perception (three cross-plane
// processes on 11 S1.1.6 R-3 closed set).
//
// Ports (11 S1.1.4):
//   loopback  tcp/127.0.0.1:7449   RT participants only
//
// NET-C9 verbatim: RT face binds ONLY to loopback. No LAN, no WiFi.
// The RT surface exists to keep the 20 Hz cmd_vel / estop / chassis
// heartbeat off any wire that could drop it.
//
// Rules this config enforces (grep-verified by
// scripts/check_router_config.sh):
//   * mode: peer + router disabled (no cluster gossip)
//   * multicast disabled (RT-C1, the real cross-plane leak vector)
//   * gossip ENABLED (2026-08-16, F4): required for mode=peer router-brokered
//     discovery; completes the 2026-08-10 client flip. See the scouting block.
//   * NO 0.0.0.0 listen anywhere (SEC-2, SEC-7)
//   * listen limited to loopback only

{
  mode: "router",
  listen: {
    endpoints: [
      "tcp/127.0.0.1:7449",
    ],
  },
  scouting: {
    multicast: {
      enabled: false,
    },
    // gossip ENABLED (2026-08-16, F4): mode=peer participants connect to this
    // router and discover each other's pub/sub declarations via gossip. With it
    // OFF the router does not propagate those declarations between peers, so a
    // subscriber never learns of a publisher on another peer -- verified: rt/gnss
    // publish reached 0 subscribers with gossip=false, 120/6s with gossip=true.
    // This completes the 2026-08-10 client-side flip (session_config.h) that was
    // not mirrored to the routers. Multicast stays OFF (RT-C1, the real leak
    // vector). mode=client would broker without gossip (session_factory 待确认)
    // -- if that is adopted, flip this back.
    gossip: {
      enabled: true,
    },
  },
  connect: {
    endpoints: [],
  },
  transport: {
    unicast: {
      accept_timeout: 5000,
    },
  },
}
