# INF-DP-7 / CFG-BT-3 -- Nav2 behavior_server (Stage 1, spin/backup/wait only)
#
# Stage 1 of 10 S3.3 boot sequence.
# OOMScoreAdjust=-500 per 11 S11A.6.3 (see reason in the doc row).

[Unit]
Description=XBRAIN v6 Nav2 behavior_server (Stage 1, spin/backup/wait only)
Documentation=file:///opt/xbrain_v6/docs/11-%E6%8E%A5%E5%8F%A3%E5%A5%91%E7%BA%A6.md
Requires=xbrain-config-freeze.service
After=xbrain-config-freeze.service
Before=xbrain-behavior-proxy.service

[Service]
Type=simple
Restart=always
RestartSec=2s
StartLimitBurst=5
StartLimitIntervalSec=60s
OOMScoreAdjust=-500
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/xbrain_v6/ros2_ws/install/nav2_bt_navigator/lib/nav2_bt_navigator/behavior_server --ros-args --params-file /opt/xbrain_v6/configs/nav2/behavior_only.yaml
WatchdogSec=15s

[Install]
WantedBy=multi-user.target
