# INF-DP-7 / CFG-BT-3 -- Nav2 behavior_server (Stage 1, spin/backup/wait only)
#
# Stage 1 of 10 S3.3 boot sequence.
# OOMScoreAdjust=-500 per 11 S11A.6.3 (see reason in the doc row).

[Unit]
Description=XBRAIN v6 Nav2 behavior_server (Stage 1, spin/backup/wait only)
Documentation=file:///opt/xbrain_v6/docs/
Requires=xbrain-config-freeze.service
# Gated: binary not built yet -> ConditionPathExists makes systemd SKIP
# this unit cleanly (start returns success) instead of failing the boot.
ConditionPathExists=/opt/xbrain_v6/data/install/nav2_bt_navigator/lib/nav2_bt_navigator/behavior_server
After=xbrain-config-freeze.service
Before=xbrain-behavior-proxy.service
# StartLimit* live in [Unit], NOT [Service]: systemd >= v229 silently
# ignores them in [Service], voiding the restart-loop cap (README dev #1).
StartLimitBurst=5
StartLimitIntervalSec=60s

[Service]
Type=simple
Restart=always
RestartSec=2s
OOMScoreAdjust=-500
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/xbrain_v6/data/install/nav2_bt_navigator/lib/nav2_bt_navigator/behavior_server --ros-args --params-file /opt/xbrain_v6/configs/nav2/behavior_only.yaml

[Install]
WantedBy=multi-user.target
