# INF-DP-7 / CFG-BT-3 -- p1_motion (Stage 2, cross-plane, 20 Hz cmd_vel authority)
#
# Stage 2 of 10 S3.3 boot sequence.
# OOMScoreAdjust=-1000 per 11 S11A.6.3 (see reason in the doc row).

[Unit]
Description=XBRAIN v6 p1_motion (Stage 2, cross-plane, 20 Hz cmd_vel authority)
Documentation=file:///opt/xbrain_v6/docs/
Requires=xbrain-config-freeze.service
After=xbrain-quadruped.service
After=xbrain-chassis-relay.service
After=xbrain-perception.service
After=xbrain-config-freeze.service
# StartLimit* live in [Unit], NOT [Service]: systemd >= v229 silently
# ignores them in [Service], voiding the restart-loop cap (README dev #1).
StartLimitBurst=5
StartLimitIntervalSec=60s

[Service]
Type=simple
Restart=always
RestartSec=2s
OOMScoreAdjust=-1000
Environment="PYTHONUNBUFFERED=1"
# XBRAIN_ROBOT_ID is read directly at RUNTIME by the gnss->state/pose bridge
# (main_wiring.py): unset -> bridge OFF -> state/pose goes silent, the exact
# rid-mismatch that broke rt/gnss->state/pose in dev. rtk_driver reads the same
# var, so both must carry the identical rid; a single /etc/xbrain/robot.env keeps
# them on one id. The leading - keeps p1 startable if the file is absent (the
# bridge then logs OFF rather than failing the unit). p2..p5 do NOT need this --
# they take robot_id from the resolved snapshot (common.robot_id), not the env.
EnvironmentFile=-/etc/xbrain/robot.env
# CHK-1-03 / 10 S3.2 CPU affinity baseline.
# 核 4 独占(isolcpus 隔离): 20 Hz 周期 P99 的前提, RNS 的激光栅格绕障也在这个环里
# The number lives in 10 S3.2, not here; scripts/ci/check_affinity.py
# parses that table live and fails on any divergence, so editing this
# line without editing the table is caught at CI time.
CPUAffinity=4

ExecStart=/usr/bin/env python3 -m xbrain.p1_motion

[Install]
WantedBy=multi-user.target
