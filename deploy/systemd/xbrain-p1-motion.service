# INF-DP-7 / CFG-BT-3 -- p1_motion (Stage 2, cross-plane, 20 Hz cmd_vel authority)
#
# Stage 2 of 10 S3.3 boot sequence.
# OOMScoreAdjust=-1000 per 11 S11A.6.3 (see reason in the doc row).

[Unit]
Description=XBRAIN v6 p1_motion (Stage 2, cross-plane, 20 Hz cmd_vel authority)
Documentation=file:///opt/xbrain_v6/docs/
Requires=xbrain-config-freeze.service
After=xbrain-quadruped.service
After=xbrain-chassis-relay.service
After=xbrain-perception.service
After=xbrain-config-freeze.service
# StartLimit* live in [Unit], NOT [Service]: systemd >= v229 silently
# ignores them in [Service], voiding the restart-loop cap (README dev #1).
StartLimitBurst=5
StartLimitIntervalSec=60s

[Service]
# Python deps (zenoh, fastapi, sherpa_onnx) are pip --user installs under
# /home/nvidia/.local; as root they are not importable and the service dies.
User=nvidia
Group=nvidia
Type=simple
Restart=always
RestartSec=2s
OOMScoreAdjust=-1000
Environment="PYTHONUNBUFFERED=1"
# XBRAIN_ROBOT_ID is read directly at RUNTIME by the gnss->state/pose bridge
# (main_wiring.py): unset -> bridge OFF -> state/pose goes silent, the exact
# rid-mismatch that broke rt/gnss->state/pose in dev. rtk_driver reads the same
# var, so both must carry the identical rid; a single deploy/env/robot.env keeps
# them on one id. The leading - keeps p1 startable if the file is absent (the
# bridge then logs OFF rather than failing the unit). p2..p5 do NOT need this --
# they take robot_id from the resolved snapshot (common.robot_id), not the env.
# Path: in-tree since 2026-09-30 (was /etc/xbrain/robot.env; user ruling moved it
# under deploy/). Absolute because systemd does not accept a relative
# EnvironmentFile -- there is no per-unit working directory to resolve it against.
EnvironmentFile=-/opt/xbrain_v6/deploy/env/robot.env
# CHK-1-03 / 10 S3.2 CPU affinity baseline (user rulings 99 U93 + U94).
# Cores 0,4,5,6 are ours and 1,2,3,7 belong to perception. Our processes are
# scheduled freely across 0,4-6 -- no per-core pinning; if T7 cycle measurements
# ever ask for pinning, it is planned inside 0,4-6 only (10 S3.2 pinning trigger).
# The number lives in 10 S3.2, not here; scripts/ci/check_affinity.py
# parses that table live and fails on any divergence, so editing this
# line without editing the table is caught at CI time.
CPUAffinity=0,4-6

# *** --voice-loop is the FUNCTIONAL wiring (main_wiring.run_voice_loop_wiring), despite
# the name. Without it __main__ runs main_loop, a heartbeat-only skeleton: the process
# stays "active" and does nothing. Until 2026-10-26 every P1..P5 unit started that
# skeleton, while the stack that actually worked was launched by a dev script with the
# flag (99 U95 follow-up, found while making the units the delivery path).
ExecStart=/usr/bin/env python3 -m xbrain.p1_motion --voice-loop

[Install]
WantedBy=multi-user.target
