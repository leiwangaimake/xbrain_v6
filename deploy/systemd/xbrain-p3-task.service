# INF-DP-7 / CFG-BT-3 -- p3_task (Stage 3, task queue + charging + fence writer)
#
# Stage 3 of 10 S3.3 boot sequence.
# OOMScoreAdjust=-500 per 11 S11A.6.3 (see reason in the doc row).

[Unit]
Description=XBRAIN v6 p3_task (Stage 3, task queue + charging + fence writer)
Documentation=file:///opt/xbrain_v6/docs/
Requires=xbrain-config-freeze.service
After=xbrain-p2-core.service
After=xbrain-config-freeze.service
# StartLimit* live in [Unit], NOT [Service]: systemd >= v229 silently
# ignores them in [Service], voiding the restart-loop cap (README dev #1).
StartLimitBurst=5
StartLimitIntervalSec=60s

[Service]
Type=simple
Restart=always
RestartSec=2s
OOMScoreAdjust=-500
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/env python3 -m xbrain.p3_task

[Install]
WantedBy=multi-user.target
