# INF-DP-7 / CFG-BT-3 -- p5_gateway (Stage 3, HMI backend + event pipeline)
#
# Stage 3 of 10 S3.3 boot sequence.
# OOMScoreAdjust=200 per 11 S11A.6.3 (see reason in the doc row).

[Unit]
Description=XBRAIN v6 p5_gateway (Stage 3, HMI backend + event pipeline)
Documentation=file:///opt/xbrain_v6/docs/
# p5_gateway supports minimal mode WITHOUT freeze -- observation window
# per 10 S3.3 requires this unit start even if freeze failed.
# So NO 'Requires=xbrain-config-freeze.service' here.
After=xbrain-p4-agent.service
# StartLimit* live in [Unit], NOT [Service]: systemd >= v229 silently
# ignores them in [Service], voiding the restart-loop cap (README dev #1).
StartLimitBurst=5
StartLimitIntervalSec=60s

[Service]
Type=simple
Restart=always
RestartSec=2s
OOMScoreAdjust=200
Environment="PYTHONUNBUFFERED=1"
# CHK-1-03 / 10 S3.2 CPU affinity baseline (user ruling 2026-10-25, 99 U93).
# Cores 0-3 are ours and 4-7 belong to perception. Our processes are scheduled
# freely across 0-3 -- no per-core pinning; if T7 cycle measurements ever ask
# for pinning, it is planned inside 0-3 only (10 S3.2 pinning trigger).
# The number lives in 10 S3.2, not here; scripts/ci/check_affinity.py
# parses that table live and fails on any divergence, so editing this
# line without editing the table is caught at CI time.
CPUAffinity=0-3

ExecStart=/usr/bin/env python3 -m xbrain.p5_gateway

[Install]
WantedBy=multi-user.target
