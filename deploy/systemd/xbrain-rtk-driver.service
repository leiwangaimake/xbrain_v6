# INF-DP-7 / CFG-BT-3 -- rtk_driver (Stage 1, RTK GPS + heading + clock)
#
# Stage 1 of 10 S3.3 boot sequence: an RT-plane participant, publishes
# rt/gnss/heading + rt/gnss/fix (11 S3.2/S3.3) + rt/clock/status (S3.11, CLK-A1).
# OOMScoreAdjust=-500 per 11 S11A.6.3.
#
# Build: it is a plain-CMake binary (not colcon), so ExecStart points at the
# CMake build dir. Deploy must have run:
#   cd /opt/xbrain_v6/ros2_ws/sensor && cmake -B build && cmake --build build
# LD_LIBRARY_PATH carries libzenohc (installed to /usr/local by the zenoh-c step).
# SupplementaryGroups=dialout lets it open /dev/ttyACM0 without a chmod.
# XBRAIN_ROBOT_ID (the {rid} key segment) comes from /etc/xbrain/robot.env, the
# same site identity the rest of the stack uses; if absent the process refuses to
# start (3.1: no default rid). No WatchdogSec: this binary does not sd_notify.

[Unit]
Description=XBRAIN v6 rtk_driver (Stage 1, RTK GPS + heading + clock)
Documentation=file:///opt/xbrain_v6/docs/
Requires=xbrain-config-freeze.service
After=xbrain-zenohd-rt.service
After=xbrain-config-freeze.service
# StartLimit* live in [Unit], NOT [Service]: systemd >= v229 silently
# ignores them in [Service], voiding the restart-loop cap (README dev #1).
StartLimitBurst=5
StartLimitIntervalSec=60s

[Service]
Type=simple
Restart=always
RestartSec=2s
OOMScoreAdjust=-500
SupplementaryGroups=dialout
EnvironmentFile=-/etc/xbrain/robot.env
Environment="LD_LIBRARY_PATH=/usr/local/lib"
# DEC-15 (U83): the install root is /opt/xbrain_v6/data/install, and every OTHER
# C++ unit now points there. rtk_driver still points at its raw CMake BUILD tree
# because its CMakeLists has NO install() rule -- it can only build, not install,
# and the ORIN has no colcon. This is the one C++ binary that actually exists, so
# keeping the working build/ path beats pointing at an empty data/install. Migrate
# to /opt/xbrain_v6/data/install/... once DEP-5 adds the install() rule (NEXT.md).
ExecStart=/opt/xbrain_v6/ros2_ws/sensor/build/rtk_driver

[Install]
WantedBy=multi-user.target
