# INF-DP-7 / CFG-BT-3 -- p4_agent (Stage 3, intent pipeline + AI gateway)
#
# Stage 3 of 10 S3.3 boot sequence.
# OOMScoreAdjust=200 per 11 S11A.6.3 (see reason in the doc row).

[Unit]
Description=XBRAIN v6 p4_agent (Stage 3, intent pipeline + AI gateway)
Documentation=file:///opt/xbrain_v6/docs/
Requires=xbrain-config-freeze.service
After=xbrain-p3-task.service
After=xbrain-config-freeze.service
# StartLimit* live in [Unit], NOT [Service]: systemd >= v229 silently
# ignores them in [Service], voiding the restart-loop cap (README dev #1).
StartLimitBurst=5
StartLimitIntervalSec=60s

[Service]
Type=simple
Restart=always
RestartSec=2s
OOMScoreAdjust=200
Environment="PYTHONUNBUFFERED=1"
# CHK-1-03 / 10 S3.2 CPU affinity baseline.
# 核 7: 同上
# The number lives in 10 S3.2, not here; scripts/ci/check_affinity.py
# parses that table live and fails on any divergence, so editing this
# line without editing the table is caught at CI time.
CPUAffinity=7

ExecStart=/usr/bin/env python3 -m xbrain.p4_agent

[Install]
WantedBy=multi-user.target
