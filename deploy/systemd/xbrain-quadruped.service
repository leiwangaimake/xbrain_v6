# INF-DP-7 / CFG-BT-3 -- quadruped (Stage 1, C++ chassis interface)
#
# Stage 1 of 10 S3.3 boot sequence.
# OOMScoreAdjust=-1000 per 11 S11A.6.3 (see reason in the doc row).

[Unit]
Description=XBRAIN v6 quadruped (Stage 1, C++ chassis interface)
Documentation=file:///opt/xbrain_v6/docs/
Requires=xbrain-config-freeze.service
# Gated: binary not built yet -> ConditionPathExists makes systemd SKIP
# this unit cleanly (start returns success) instead of failing the boot.
ConditionPathExists=/opt/xbrain_v6/data/install/quadruped/lib/quadruped/quadruped_m20
After=xbrain-zenohd-rt.service
After=xbrain-zenohd-gen.service
After=xbrain-config-freeze.service
Before=xbrain-p1-motion.service
# StartLimit* live in [Unit], NOT [Service]: systemd >= v229 silently
# ignores them in [Service], voiding the restart-loop cap (README dev #1).
StartLimitBurst=5
StartLimitIntervalSec=60s

[Service]
Type=simple
Restart=always
RestartSec=2s
# B0 (2026-09-15) only. The installed binary is the skeleton: config loader +
# single-tx-owner seam + self-check, with no chassis link yet (13 S2.2 lands in
# batch B1/B2). It exits 78 (EX_CONFIG) when invoked with no argument -- which
# is how this unit invokes it -- so that "Stage 1 is up" cannot be true while
# nothing is talking to the chassis. Without the line below, Restart=always
# would turn that one honest refusal into a restart loop that fills the journal
# and hides the message. REMOVE THIS LINE together with the refusal branch in
# src/main.cc when the process becomes real; leaving it in would mask a genuine
# config failure at exactly the moment it starts to matter.
RestartPreventExitStatus=78
OOMScoreAdjust=-1000
Environment="PYTHONUNBUFFERED=1"
# CHK-1-03 / 10 S3.2 CPU affinity baseline.
# 核 5 独占: C++ 实时线程
# The number lives in 10 S3.2, not here; scripts/ci/check_affinity.py
# parses that table live and fails on any divergence, so editing this
# line without editing the table is caught at CI time.
CPUAffinity=5

# ---- the two limits the realtime design cannot work without -------------
#
# Measured on the ORIN 2026-09-15: DefaultLimitMEMLOCK=65536 (64 KB) and
# DefaultLimitRTPRIO=0. Under those defaults BOTH realtime requirements of
# 13 S9 fail, and each fails in a way that is easy to miss:
#
#   mlockall(MCL_CURRENT|MCL_FUTURE)   returns ENOMEM (13 S9.2 RTC-7). The
#       process keeps running, with its pages pageable -- so the 20 Hz control
#       loop meets its deadline until the first time the kernel decides to
#       reclaim, and then misses it by however long the fault takes.
#   sched_setscheduler(SCHED_FIFO, 80) returns EPERM (13 S9.1, the ctrl
#       thread). The thread keeps running at ordinary priority, which is
#       invisible until something else on core 5 gets busy.
#
# Neither produces a log line by itself. common/include/xbrain/rtcomm/
# rt_thread.h returns the errno rather than a bool precisely so the caller can
# say WHICH of these two it was -- but it can only say so if somebody asks.
#
# RTPRIO is 80 and not 99: 13 S9.1 assigns ctrl 80 and chs_b 70, and a ceiling
# above what the design uses grants a privilege nothing needs.
LimitMEMLOCK=infinity
LimitRTPRIO=80

ExecStart=/opt/xbrain_v6/data/install/quadruped/lib/quadruped/quadruped_m20

[Install]
WantedBy=multi-user.target
