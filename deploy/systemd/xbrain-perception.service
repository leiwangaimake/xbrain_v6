# INF-DP-7 / CFG-BT-3 -- perception (Stage 1, C++ RGBD + LIDAR)
#
# Stage 1 of 10 S3.3 boot sequence.
# OOMScoreAdjust=-900 per 11 S11A.6.3 (see reason in the doc row).

[Unit]
Description=XBRAIN v6 perception (Stage 1, C++ RGBD + LIDAR)
Documentation=file:///opt/xbrain_v6/docs/
Requires=xbrain-config-freeze.service
# Gated: binary not built yet -> ConditionPathExists makes systemd SKIP
# this unit cleanly (start returns success) instead of failing the boot.
ConditionPathExists=/opt/xbrain_v6/data/install/perception/lib/perception/perception_node
After=xbrain-zenohd-rt.service
After=xbrain-zenohd-gen.service
After=xbrain-config-freeze.service
# StartLimit* live in [Unit], NOT [Service]: systemd >= v229 silently
# ignores them in [Service], voiding the restart-loop cap (README dev #1).
StartLimitBurst=5
StartLimitIntervalSec=60s

[Service]
Type=simple
Restart=always
RestartSec=2s
# 99 U91(2) / issues.md 10.1: 69 = 相机 SDK 线程摆放的恢复调用失败,
# 感知在这种情况下直接退出, 不带着错误的核约束跑 (fail-safe).
# 这是 [确定性] 失败 -- 同样的权限问题重启一次还是同样失败 --
# 而 Restart=always + RestartSec=2s 会让它每 2 秒重启一次, 无限循环.
# 形制同 13 ASM-5 对 78 (EX_CONFIG) 的处理: 重启修不好它, 就不要重启.
# 注意与 OOM (137) / 段错误的区别: 那些值得重启, 所以这里只列 69.
RestartPreventExitStatus=69
OOMScoreAdjust=-900
Environment="PYTHONUNBUFFERED=1"
# CHK-1-03 / 10 S3.2 CPU affinity baseline.
# 核 2-3: C++ 负载最重, 含点云逐点处理
# The number lives in 10 S3.2, not here; scripts/ci/check_affinity.py
# parses that table live and fails on any divergence, so editing this
# line without editing the table is caught at CI time.
CPUAffinity=2-3

ExecStart=/opt/xbrain_v6/data/install/perception/lib/perception/perception_node

[Install]
WantedBy=multi-user.target
