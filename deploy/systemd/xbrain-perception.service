# INF-DP-7 / CFG-BT-3 -- perception (Stage 1, C++ RGBD + LIDAR)
#
# Stage 1 of 10 S3.3 boot sequence.
# OOMScoreAdjust=-900 per 11 S11A.6.3 (see reason in the doc row).

[Unit]
Description=XBRAIN v6 perception (Stage 1, C++ RGBD + LIDAR)
Documentation=file:///opt/xbrain_v6/docs/
Requires=xbrain-config-freeze.service
# Gated: binary not built yet -> ConditionPathExists makes systemd SKIP
# this unit cleanly (start returns success) instead of failing the boot.
ConditionPathExists=/opt/xbrain_v6/ros2_ws/install/perception/lib/perception/perception_node
After=xbrain-zenohd-rt.service
After=xbrain-zenohd-gen.service
After=xbrain-config-freeze.service
# StartLimit* live in [Unit], NOT [Service]: systemd >= v229 silently
# ignores them in [Service], voiding the restart-loop cap (README dev #1).
StartLimitBurst=5
StartLimitIntervalSec=60s

[Service]
Type=simple
Restart=always
RestartSec=2s
OOMScoreAdjust=-900
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/xbrain_v6/ros2_ws/install/perception/lib/perception/perception_node

[Install]
WantedBy=multi-user.target
