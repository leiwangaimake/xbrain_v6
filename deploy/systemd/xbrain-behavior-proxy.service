# INF-DP-7 / CFG-BT-3 -- behavior_proxy (Stage 1, Nav2 <-> Zenoh translator)
#
# Stage 1 of 10 S3.3 boot sequence.
# OOMScoreAdjust=-500 per 11 S11A.6.3 (see reason in the doc row).

[Unit]
Description=XBRAIN v6 behavior_proxy (Stage 1, Nav2 <-> Zenoh translator)
Documentation=file:///opt/xbrain_v6/docs/11-%E6%8E%A5%E5%8F%A3%E5%A5%91%E7%BA%A6.md
Requires=xbrain-config-freeze.service
After=xbrain-zenohd-rt.service
After=xbrain-config-freeze.service
After=xbrain-nav2-behavior.service


[Service]
Type=simple
Restart=always
RestartSec=2s
StartLimitBurst=5
StartLimitIntervalSec=60s
OOMScoreAdjust=-500
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/xbrain_v6/ros2_ws/install/behavior_proxy/lib/behavior_proxy/behavior_proxy
WatchdogSec=15s

[Install]
WantedBy=multi-user.target
