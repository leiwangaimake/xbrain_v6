# INF-ZN-8 / CFG-BT-2 -- GEN-plane Zenoh router (Stage 0z-2).
#
# The GEN router carries general-plane traffic (state/*, cmd/*, event/*)
# for p2_core, p3_task, p4_agent, p5_gateway, behavior_proxy, cloud
# uplink via LAN2 / WiFi.
#
# Boot placement (10 S3.3): Stage 0z-2 -- after the RT router
# (Stage 0z-1) but before Stage 0z-3 (chassis probe) and 0c
# (config-freeze).
#
# Per-port binding (NET-C9 verbatim): binds ONLY specific IPs, never
# 0.0.0.0. LAN2_IP / WIFI_IP come from /etc/xbrain/network.env at
# service start via EnvironmentFile= below. If either env var is
# missing, envsubst emits a literal "${LAN2_IP}" that zenohd rejects
# as an invalid endpoint -- refusing to start beats binding wildcard.
#
# Failure discipline: hard-gated. Same as RT router (10 S3.3.6 row 13
# = R class).

[Unit]
Description=XBRAIN v6 GEN-plane Zenoh router (Stage 0z-2, per-IP binding)
Documentation=file:///opt/xbrain_v6/docs/
Requires=run-xbrain.mount
After=run-xbrain.mount network-online.target xbrain-zenohd-rt.service
Before=xbrain-config-freeze.service
# StartLimit* live in [Unit], NOT [Service]: systemd >= v229 silently
# ignores them in [Service], voiding the restart-loop cap (README dev #1).
StartLimitBurst=5
StartLimitIntervalSec=60s

[Service]
Type=simple
Restart=always
RestartSec=2s
# Deploy writes /etc/xbrain/network.env with LAN2_IP / WIFI_IP per
# site. Missing file = service refuses to start (per-site config is
# mandatory for the GEN router; a default would silently bind wrong).
EnvironmentFile=/etc/xbrain/network.env
# Resolved config path: envsubst expands ${LAN2_IP} / ${WIFI_IP} into
# a per-boot copy under /run/xbrain/zenoh/zenohd-gen.json5. Prevents
# the source template from ever containing resolved values.
ExecStartPre=/usr/bin/mkdir -p /run/xbrain/zenoh
ExecStartPre=/usr/bin/env bash -c 'envsubst < /opt/xbrain_v6/deploy/zenoh/zenohd-gen.json5 > /run/xbrain/zenoh/zenohd-gen.json5'
# Refuse to start if the resolved config still contains an unsubstituted
# ${...} placeholder. -qF matches the LITERAL two chars ${ (fixed string,
# no regex). Systemd double-quotes the arg and $$ emits one $, so bash's
# single quotes keep ${ literal. The earlier form '"\${"' was an unknown
# systemd escape -> bash saw "${" -> bad substitution -> bash errored ->
# the leading ! swallowed the error and the check could NEVER fail
# (CLAUDE.md 3.2 "always-green assertion").
# GAP: an UNSET LAN2_IP/WIFI_IP is NOT caught here -- envsubst writes the
# empty string, not ${...}, so no placeholder remains to grep; the endpoint
# then reads tcp/:7447, which zenohd may treat as bind-all (NET-C9 risk).
# The 0.0.0.0 check below does not catch it either. A real non-empty-var
# guard is still owed -- see docs/NEXT.md.
ExecStartPre=/usr/bin/env bash -c "! grep -qF '$${' /run/xbrain/zenoh/zenohd-gen.json5"
# Refuse if the resolved config contains 0.0.0.0 anywhere (belt-and-
# braces vs a hand edit that slipped past code review).
ExecStartPre=/usr/bin/env bash -c '! grep -q "0\\.0\\.0\\.0" /run/xbrain/zenoh/zenohd-gen.json5'
# CHK-1-03 / 10 S3.2 CPU affinity baseline.
# 核 1: 与 zenoh-bridge / P5 / FTP 同属云端方向的网络 I/O, 共核不引入新的跨核唤醒
# The number lives in 10 S3.2, not here; scripts/ci/check_affinity.py
# parses that table live and fails on any divergence, so editing this
# line without editing the table is caught at CI time.
CPUAffinity=1

ExecStart=/usr/local/bin/zenohd \
    --config /run/xbrain/zenoh/zenohd-gen.json5

[Install]
WantedBy=multi-user.target
