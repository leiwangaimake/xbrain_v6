# * Installed by scripts/install_units.sh. 99 U95 (2026-10-26, user ruling) ended
# the draft status: DEC-15 itself was closed by 99 U83 (2026-08-17); the values
# below are adopted as written. See README.md.
#
# *** Until 2026-10-26 this unit had NO contract row and every value below not traceable
# to a PAY-* or T-PAY-* constraint was marked 契约未规定-建议 (a proposal). 99 U95 adopted
# them as written and 11 S11A.6.3's OOM table now carries the payload row (+300, 512M);
# the 契约未规定-建议 marks below record where each number came from.

[Unit]
Description=XBRAIN payload-service - GZH-2 audio/lights bridge (8519/8529)
After=network-online.target xbrain-config-freeze.service

# *** 契约未规定-建议. Same shape as the two AI units so the three fail alike, but the
# reasoning differs: restarting this service drops the 8519 and 8529 sockets, and PAY-L2
# makes it the single holder of both -- a restart loop would leave the device link
# flapping rather than merely unavailable.
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
# Python deps (zenoh, fastapi, sherpa_onnx) are pip --user installs under
# /home/nvidia/.local; as root they are not importable and the service dies.
User=nvidia
Group=nvidia
Type=exec
ExecStart=/opt/xbrain_v6/services/payload/payload_server.sh
Restart=on-failure
RestartSec=5

# * AIR-P3 names three services and this is the third, core number superseded by
# 99 U93/U94. Its work is socket I/O and small frame assembly; it now shares
# our pool, cores 0,4-6 (10 S3.2), freely with the other processes.
# The number lives in 10 S3.2, not here; scripts/ci/check_affinity.py
# parses that table live and fails on any divergence, so editing this
# line without editing the table is caught at CI time.
CPUAffinity=0,4-6

# *** 契约未规定-建议 (+300). Between ai_asr (+400) and p4/p5 (+200): losing payload costs
# the voice output path and the deterrent, which is worse than losing generated replies
# but not as bad as losing the gateway. * Setting SOMETHING is the point -- an unset value
# is 0, which under 11 §11A.6.3's own argument makes it a more likely victim than
# llama-server (+500) despite being 8x smaller and far more load-bearing.
OOMScoreAdjust=300

# *** 契约未规定-建议. Measured 59 MiB resident (2026-08-03, Orin) -- it holds no model,
# only sockets and a 6 s siren PCM buffer. 512M is deep headroom that would still catch a
# runaway.
MemoryMax=512M
MemorySwapMax=0

# ** T-PAY-4: the shutdown path must be allowed to finish. config.close_flush_ms is 200 ms
# and app.py's lifespan does session.aclose() before link.stop(), so the device receives
# its reset frames BEFORE the sockets close. A TimeoutStopSec below that flush would
# SIGKILL mid-reset, and the contract states the observed consequence: 探照灯卡在开着 --
# a searchlight stuck on, at night, with no process left to turn it off. 10 s is far above
# the 200 ms floor because being generous here costs nothing and being tight costs that.
TimeoutStopSec=10

# *** 契约未规定-建议, same reasoning as the other two.
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
