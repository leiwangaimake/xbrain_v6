# INF-DP-7 / CFG-BT-3 -- chassis_relay (Stage 2, cross-plane emergency-stop relay)
#
# Stage 2 of 10 S3.3 boot sequence.
# OOMScoreAdjust=-1000 per 11 S11A.6.3 (see reason in the doc row).

[Unit]
Description=XBRAIN v6 chassis_relay (Stage 2, cross-plane emergency-stop relay)
Documentation=file:///opt/xbrain_v6/docs/
Requires=xbrain-config-freeze.service
# Gated: binary not built yet -> ConditionPathExists makes systemd SKIP
# this unit cleanly (start returns success) instead of failing the boot.
ConditionPathExists=/opt/xbrain_v6/data/install/chassis_relay/lib/chassis_relay/chassis_relay
After=xbrain-quadruped.service
After=xbrain-config-freeze.service
Before=xbrain-p1-motion.service
# StartLimit* live in [Unit], NOT [Service]: systemd >= v229 silently
# ignores them in [Service], voiding the restart-loop cap (README dev #1).
StartLimitBurst=5
StartLimitIntervalSec=60s

[Service]
# 2026-09-26: Type=notify + WatchdogSec RESTORED together with the binary --
# the deferral note below this block used to say "re-add BOTH together when
# the binary implements sd_notify", and it now does: a hand-rolled
# NOTIFY_SOCKET datagram sender (ros2_ws/chassis_relay/include/chassis_relay/
# sd_notify.h) sends READY=1 once the forwarding is wired and WATCHDOG=1
# every 1 s from the housekeeping thread. That thread never touches zenoh,
# so no blocked put can starve the ping (the CRL-6 thread split in
# relay_core.h); a missed ping means the process is genuinely wedged and a
# restart is the CRL-4 supervised recovery.
# WatchdogSec=5s: five missed 1 s pings. Deployment parameter, not contract
# (10 S3.3.8 mandates the watchdog's existence, not its period).
Type=notify
WatchdogSec=5s
Restart=always
RestartSec=1s
OOMScoreAdjust=-1000
Environment="PYTHONUNBUFFERED=1"
# CHK-1-03 / 10 S3.2 CPU affinity baseline.
# 核 6: 急停链路, 无 GIL 无 GC (CRL-4 无动态分配无阻塞日志)
# The number lives in 10 S3.2, not here; scripts/ci/check_affinity.py
# parses that table live and fails on any divergence, so editing this
# line without editing the table is caught at CI time.
CPUAffinity=6

ExecStart=/opt/xbrain_v6/data/install/chassis_relay/lib/chassis_relay/chassis_relay

[Install]
WantedBy=multi-user.target
