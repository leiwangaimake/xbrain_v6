# INF-DP-7 / CFG-BT-3 -- chassis_relay (Stage 2, cross-plane emergency-stop relay)
#
# Stage 2 of 10 S3.3 boot sequence.
# OOMScoreAdjust=-1000 per 11 S11A.6.3 (see reason in the doc row).

[Unit]
Description=XBRAIN v6 chassis_relay (Stage 2, cross-plane emergency-stop relay)
Documentation=file:///opt/xbrain_v6/docs/
Requires=xbrain-config-freeze.service
# Gated: binary not built yet -> ConditionPathExists makes systemd SKIP
# this unit cleanly (start returns success) instead of failing the boot.
ConditionPathExists=/opt/xbrain_v6/ros2_ws/install/chassis_relay/lib/chassis_relay/chassis_relay
After=xbrain-quadruped.service
After=xbrain-config-freeze.service
Before=xbrain-p1-motion.service
# StartLimit* live in [Unit], NOT [Service]: systemd >= v229 silently
# ignores them in [Service], voiding the restart-loop cap (README dev #1).
StartLimitBurst=5
StartLimitIntervalSec=60s

[Service]
Type=simple
Restart=always
RestartSec=1s
OOMScoreAdjust=-1000
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/xbrain_v6/ros2_ws/install/chassis_relay/lib/chassis_relay/chassis_relay
# WatchdogSec DEFERRED, not dropped: 10 S3.3.8 mandates a watchdog on THIS
# unit (the emergency-stop relay is the one place S3.3.8 names besides P1).
# It was removed because a watchdog without sd_notify kills the process at
# the timeout (empirically confirmed 2026-08-16) and chassis_relay does not
# yet emit WATCHDOG=1. Re-add BOTH together when the binary implements
# sd_notify: Type=notify + WatchdogSec=<T>. Adding WatchdogSec alone brings
# back the restart loop; see docs/NEXT.md.

[Install]
WantedBy=multi-user.target
