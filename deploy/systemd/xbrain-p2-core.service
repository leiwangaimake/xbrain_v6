# INF-DP-7 / CFG-BT-3 -- p2_core (Stage 3, arbiter + mode SM + BIT)
#
# Stage 3 of 10 S3.3 boot sequence.
# OOMScoreAdjust=-500 per 11 S11A.6.3 (see reason in the doc row).

[Unit]
Description=XBRAIN v6 p2_core (Stage 3, arbiter + mode SM + BIT)
Documentation=file:///opt/xbrain_v6/docs/
Requires=xbrain-config-freeze.service
After=xbrain-p1-motion.service
After=xbrain-config-freeze.service
# StartLimit* live in [Unit], NOT [Service]: systemd >= v229 silently
# ignores them in [Service], voiding the restart-loop cap (README dev #1).
StartLimitBurst=5
StartLimitIntervalSec=60s

[Service]
Type=simple
Restart=always
RestartSec=2s
OOMScoreAdjust=-500
Environment="PYTHONUNBUFFERED=1"
# CHK-1-03 / 10 S3.2 CPU affinity baseline (user rulings 99 U93 + U94).
# Cores 0,4,5,6 are ours and 1,2,3,7 belong to perception. Our processes are
# scheduled freely across 0,4-6 -- no per-core pinning; if T7 cycle measurements
# ever ask for pinning, it is planned inside 0,4-6 only (10 S3.2 pinning trigger).
# The number lives in 10 S3.2, not here; scripts/ci/check_affinity.py
# parses that table live and fails on any divergence, so editing this
# line without editing the table is caught at CI time.
CPUAffinity=0,4-6

# rid for the cloud bridge, state/voice_turn and the cmd/chassis/ctrl envelope (p4),
# p5's cloud face. Without it p5 only logs a WARNING and drops the whole cloud face;
# p4 refuses to send the posture command (no rid to put in the S3.0 envelope).
EnvironmentFile=-/opt/xbrain_v6/deploy/env/robot.env
# *** --voice-loop is the FUNCTIONAL wiring (main_wiring.run_voice_loop_wiring), despite
# the name. Without it __main__ runs main_loop, a heartbeat-only skeleton: the process
# stays "active" and does nothing. Until 2026-10-26 every P1..P5 unit started that
# skeleton, while the stack that actually worked was launched by a dev script with the
# flag (99 U95 follow-up, found while making the units the delivery path).
ExecStart=/usr/bin/env python3 -m xbrain.p2_core --voice-loop

[Install]
WantedBy=multi-user.target
