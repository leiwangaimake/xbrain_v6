# File: med-nat.env
# Brief: Inputs for xbrain-med-nat.sh (MED-1 PTZ NAT); install to /etc/xbrain/med-nat.env
#
# Description:
# Values below are the 2026-10-24 bring-up on .1.26 (operator segment = wifi).
# They are SITE values: at deployment EXT_IF / EXT_IP become the LAN2 port
# (U-15) and ALLOW_SRC becomes the Qt master PC (192.168.123.60, v2.0 S4.6).
# The external IP and ports must match configs/p5_gateway.yaml media.endpoints
# url -- that is what state/media tells Qt to dial.

# Interface and address Qt connects to.
#   2026-10-25 (99 U92): moved from wifi (wlP7p1s0 / 192.168.1.26) to LAN2 --
#   the party-A ad-hoc network is the delivery network and wifi is debug-only.
#   The script takes ONE external interface, so wifi no longer reaches the
#   cameras through this NAT.
EXT_IF=lan2
EXT_IP=192.168.188.200
# Interface the cameras are on, and this host's address on that segment (SNAT).
#   lan0 = MAC 64:62:66:01:20:1d (/etc/systemd/network/05-xbrain-lan0.link).
#   2026-10-25: the name did not stick across boots -- the board vendor's
#   /etc/udev/rules.d/99-miivii-eth-rename.rules renamed the two igc ports
#   back to eth1/eth2 on the event the rename itself raises. That rule is
#   disabled (moved to *.disabled-by-xbrain), so the MAC-keyed .link files
#   are the only naming source and lan0 exists again.
INT_IF=lan0
SNAT_IP=192.168.66.200
# Space-separated operator sources. Never 0.0.0.0/0 (SEC-2 / MED-C2).
#   99 U92: comm_module_peer_cidr = the whole party-A ad-hoc /24 (cloud is
#   192.168.188.100, but the user ruled the whole /24, not just .100).
ALLOW_SRC="192.168.188.0/24"
# external_port=camera_host:camera_port. External ports: 554 / 8554 only (MED-C1).
#   554  -> visible light (Uniview LAPI), /media/video1 main, /media/video2 sub
#   8554 -> thermal (Dahua CGI), /cam/realmonitor?channel=1&subtype=0|1
MAPS="554=192.168.66.13:554 8554=192.168.66.108:554"
