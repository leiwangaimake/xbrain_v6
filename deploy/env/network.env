# /opt/xbrain_v6/deploy/env/network.env -- the LIVE file, not a template.
#
# Moved here from /etc/xbrain/network.env by the same 2026-09-30 user ruling that
# moved robot.env ("not under /etc, put it under xbrain_v6/deploy"); the
# copy-then-edit step is gone and xbrain-zenohd-gen.service reads this path
# directly. See deploy/env/robot.env for the full rationale and for the three
# /etc/xbrain files that deliberately did NOT move.
#
# WHY THE TWO VALUES BELOW ARE STILL LOOPBACK, unlike robot.env's rid
#   robot.env's rid had a ruled value to write; these two do not. 11 S1.1.9.2's
#   segment table reads "pending U-15" for LAN2, 10 S4.5 calls the LAN2 segment
#   the one remaining blocker, and configs/common.yaml's gen_listen key is null
#   for exactly this reason. Writing an address to make the file look finished is
#   what CLAUDE.md 3.6 (iron rule 3) forbids. The loopback placeholders below are
#   not a guess at the answer -- they are the fail-safe described next.
#
# Per-site network binding for the GEN-plane Zenoh router (xbrain-zenohd-gen.service).
# NET-C9 forbids the router from ever listening on 0.0.0.0; it must bind named IPs.
# The unit envsubst's ${LAN2_IP} / ${WIFI_IP} from this file into the per-boot resolved
# config /run/xbrain/zenoh/zenohd-gen.json5 before starting zenohd.
#
# WHY THESE DEFAULT TO 127.0.0.1 (and are NOT left empty)
#   envsubst replaces an UNSET var with the empty string, not with "${LAN2_IP}". An empty
#   LAN2_IP yields an endpoint like "tcp/:7447", which zenohd treats as bind-ALL -- the
#   exact 0.0.0.0 exposure NET-C9 forbids, reached silently. 127.0.0.1 is the fail-safe
#   placeholder: the router binds loopback only (no LAN/cloud reach, but nothing exposed)
#   until a real per-site address is written here. Degraded, never dangerous.
#
#   NOTE: there is currently NO unit-level guard that rejects an empty LAN2_IP (see
#   docs/NEXT.md, deploy hardening). Until that lands, these two values are the only thing
#   standing between a mis-provisioned host and a wildcard bind. Do not blank them.

# --- REPLACE with this site's LAN2 (wired uplink) address before enabling the GEN router ---
LAN2_IP=127.0.0.1

# --- REPLACE with this site's WiFi address, or leave as loopback if WiFi is unused ---
WIFI_IP=127.0.0.1
